/*
 * -------------------------------------------------
 *  Base Nextflow config
 * -------------------------------------------------
 *  Default resource allocations and retry logic.
 *  Mirrors the conventions used by nf-core-style
 *  pipelines so students can reuse these patterns.
 * -------------------------------------------------
 */

params {
    max_memory = '64.GB'
    max_cpus   = 16
    max_time   = '24.h'
}

process {
    // Defaults (per task attempt; multiplied by attempt for retries)
    cpus   = { 1 }
    memory = { 4.GB * task.attempt }
    time   = { 2.h  * task.attempt }

    // Retry on common OOM/SIGTERM exit codes
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // Force Numba to keep its JIT cache inside the container's writable
    // tmpfs (/tmp) instead of trying to write next to the .py sources.
    // Without this, scanpy import crashes inside the container with
    //     RuntimeError: cannot cache function ... no locator available
    // when the pipeline is launched from a WSL2 /mnt/c/* path
    // (Windows cross-mount, where InTreeCacheLocator cannot operate).
    // /tmp is always writable inside the container regardless of where
    // the host mounted the work directory, and is harmless on HPC.
    env {
        NUMBA_CACHE_DIR = '/tmp'
    }

    // Numeric BLAS threads — CellOracle / scanpy / scvelo are NUMA-sensitive
    withLabel: process_single {
        cpus   = { 1 }
        memory = { 4.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withLabel: process_low {
        cpus   = { 2 }
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { 4 }
        memory = { 16.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withLabel: process_high {
        cpus   = { 8 }
        memory = { 32.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withLabel: process_long {
        time   = { 20.h * task.attempt }
    }
    withLabel: error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}
