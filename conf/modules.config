/*
 * -------------------------------------------------
 *  Per-process / per-module configuration
 * -------------------------------------------------
 *  Anything that varies by process (labels, container
 *  selection, publishDir, extra args) lives here so
 *  that the module files in modules/ stay declarative.
 * -------------------------------------------------
 */

process {
    // ---------------------------------------------------------------
    //  Single container shared by every process.
    //  Override via `--celloracle_container` or `-with-container`.
    // ---------------------------------------------------------------
    withLabel: celloracle {
        container = { params.celloracle_container }
        cpus      = 4
        memory    = '16.GB'
    }

    // ---------------------------------------------------------------
    //  Per-process directives
    // ---------------------------------------------------------------
    withName: 'CO_DATA_PREP' {
        label       = 'celloracle'
        publishDir  = [
            path: { "${params.outdir}/01_preprocess" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'CO_PSEUDOTIME' {
        label       = 'celloracle'
        publishDir  = [
            path: { "${params.outdir}/02_pseudotime" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'CO_GRN_INFERENCE' {
        label       = 'celloracle'
        publishDir  = [
            path: { "${params.outdir}/03_grn" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'CO_PERTURBATION' {
        label       = 'celloracle'
        publishDir  = [
            path: { "${params.outdir}/04_perturbation" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'CO_GRADIENT_DEV' {
        label       = 'celloracle'
        publishDir  = [
            path: { "${params.outdir}/05_gradient_dev" },
            mode: params.publish_dir_mode
        ]
    }
}
