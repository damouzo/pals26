/*
 * -------------------------------------------------
 *  pals26 Nextflow config
 * -------------------------------------------------
 *  Educational Nextflow (DSL2) implementation of the
 *  CellOracle GRN-inference + in-silico perturbation
 *  tutorial using the scvelo pancreas dataset.
 * -------------------------------------------------
 */

manifest {
    name            = 'pals26'
    author          = 'damouzo'
    homePage        = 'https://github.com/damouzo/pals26'
    description     = 'Nextflow (DSL2) port of the CellOracle scvelo-pancreas tutorial'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.10.0'
    version         = '0.1.0'
}

// ---------------------------------------------------------------------------
// Global default params
// ---------------------------------------------------------------------------
params {
    // I/O
    outdir              = './results'
    publish_dir_mode    = 'copy'      // 'copy' | 'symlink' 

    // Pipeline-level switches
    run_preprocess      = true
    run_pseudotime      = true
    run_grn             = true
    run_perturbation    = true
    run_gradient        = true

    // Data / preprocessing
    dataset             = 'pancreas'          // scv.datasets key
    leiden_resolution   = 0.3
    hvg_n_top_genes     = null                // null = scanpy default (2000)
    n_pca_components    = 'auto'              // 'auto' => knee point of explained variance
    filter_min_cells    = 1

    // Pseudotime
    pseudotime_cluster_col = 'leiden'
    pseudotime_lineage     = 'the_one'

    // GRN inference
    knn_k                 = 'auto'            // 'auto' => int(0.025 * n_cells)
    knn_balanced          = true
    knn_n_jobs            = 4
    grn_alpha             = 10
    grn_filter_p          = 0.001
    grn_filter_max_links  = 10000

    // Perturbation
    perturb_tf            = 'Mafb'
    perturb_value         = 0.0
    perturb_n_propagation = 3
    perturb_n_neighbors   = 200
    perturb_sigma_corr    = 0.05
    p_mass_n_grid         = 40
    p_mass_smooth         = 0.8
    p_mass_min_mass       = 6.2

    // Gradient / dev module
    gradient_n_poly       = 3
    dev_n_bins            = 10

    // Boilerplate
    help                 = false
    validate_params      = true

    // Container
    // Default: ghcr.io/damouzo/pals26:latest
    // Override at runtime with `-with-container <image>` or
    // `--celloracle_container <image>` (e.g. a locally-built .sif).
    celloracle_container = 'ghcr.io/damouzo/pals26:latest'
}

// ---------------------------------------------------------------------------
// Resource limits
// ---------------------------------------------------------------------------
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------
profiles {
    // ---------- Local / laptop / workstation ----------
    // Laptop-friendly defaults: 2 CPUs / 6 GB per task. The 'celloracle'
    // label in conf/modules.config still requests 4 CPUs / 16 GB by
    // default, so we override it here. If you have a beefier workstation,
    // raise both the executor ceiling and the per-process label below.
    local {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g) --platform linux/amd64'
        singularity.enabled    = false
        apptainer.enabled      = false
        executor {
            name      = 'local'
            cpus      = 2
            memory    = '6 GB'
            queueSize = 1
        }
        process {
            withLabel: celloracle {
                cpus   = 2
                memory = '6 GB'
            }
        }
    }

    // ---------- Singularity runtime (combine with cluster) ----------
    singularity {
        docker.enabled         = false
        conda.enabled          = false
        singularity.enabled    = true
        singularity.autoMounts  = true
        singularity.cacheDir    = 'work/singularity'
    }

    // ---------- SLURM cluster (generic) ----------
    cluster {
        process {
            executor       = 'slurm'
            clusterOptions = '--export=ALL'
            cpus           = 4
            memory         = '32 GB'
            time           = '04:00:00'
        }
        executor {
            queueSize        = 30
            submitRateLimit  = '20/1min'
        }

        // Raise the remote pull timeout only when the image still needs
        // to come from the registry.
        singularity.pullTimeout = '60 min'
    }

    // ---------- Test profile (tiny smoke run) ----------
    test {
        params.dataset = 'pancreas'
        process {
            withLabel: celloracle {
                cpus   = 1
                memory = '3 GB'
                time   = '01:00:00'
            }
        }
    }
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']
